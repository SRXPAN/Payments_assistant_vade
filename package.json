{
  "name": "club-payments-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bot:setup": "node scripts/call.mjs /setup",
    "bot:status": "node scripts/call.mjs /status",
    "bot:check": "node scripts/call.mjs /run-check",
    "bot:check:force": "node scripts/call.mjs /run-check?force=1",
    "seed": "node scripts/seed.mjs",
    "seed:remote": "node scripts/seed.mjs --remote",
    "db:migrate:local": "wrangler d1 migrations apply club-payments --local",
    "db:migrate": "wrangler d1 migrations apply club-payments --remote"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
